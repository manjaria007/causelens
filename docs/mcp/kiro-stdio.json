{
  "mcpServers": {
    "causelens": {
      "command": ".venv/bin/python",
      "args": [
        "-m", "causelens.mcp",
        "--transport", "stdio",
        "--dataset", "reference",
        "data/metrics_daily.csv",
        "data/events.csv"
      ],
      "env": {
        "PYTHONPATH": "."
      },
      "disabled": false,
      "autoApprove": [
        "list_datasets",
        "check_data_quality",
        "confirm_change",
        "detect_change_point",
        "daily_series",
        "match_event_candidates",
        "decompose_change",
        "test_candidates",
        "test_event_scope",
        "estimate_did",
        "check_pre_trends",
        "run_placebo",
        "project_impact",
        "power_analysis",
        "design_experiment"
      ]
    }
  }
}
